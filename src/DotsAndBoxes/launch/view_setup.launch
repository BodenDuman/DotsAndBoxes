<launch>
  <!-- Load our URDF (robot + tables + camera rig) into robot_description -->
  <param name="robot_description"
         command="xacro $(find DotsAndBoxes)/urdf/setup.urdf.xacro" />

  <!-- GUI sliders to move the arm joints -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui"
        type="joint_state_publisher_gui" />

  <!-- Publishes TF from the URDF + joint states -->
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" />

  <!-- RViz, loading our saved config if it exists -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find DotsAndBoxes)/rviz/setup.rviz" />
</launch>
